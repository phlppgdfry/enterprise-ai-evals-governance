{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PolicyRequest": {
        "additionalProperties": false,
        "properties": {
          "approved_data_source": {
            "title": "Approved Data Source",
            "type": "boolean"
          },
          "externally_visible_action": {
            "title": "Externally Visible Action",
            "type": "boolean"
          },
          "financial_posting": {
            "default": false,
            "title": "Financial Posting",
            "type": "boolean"
          },
          "owner": {
            "maxLength": 100,
            "minLength": 2,
            "title": "Owner",
            "type": "string"
          },
          "personal_data": {
            "title": "Personal Data",
            "type": "boolean"
          },
          "retention_days": {
            "maximum": 3650.0,
            "minimum": 1.0,
            "title": "Retention Days",
            "type": "integer"
          },
          "special_category_data": {
            "default": false,
            "title": "Special Category Data",
            "type": "boolean"
          },
          "use_case": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Use Case",
            "type": "string"
          }
        },
        "required": [
          "use_case",
          "personal_data",
          "externally_visible_action",
          "approved_data_source",
          "retention_days",
          "owner"
        ],
        "title": "PolicyRequest",
        "type": "object"
      },
      "RunRequest": {
        "additionalProperties": false,
        "properties": {
          "baseline_run_id": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Run Id"
          },
          "fixture": {
            "default": "good",
            "enum": [
              "good",
              "unsafe",
              "http"
            ],
            "title": "Fixture",
            "type": "string"
          },
          "thresholds": {
            "$ref": "#/components/schemas/Thresholds"
          }
        },
        "title": "RunRequest",
        "type": "object"
      },
      "Thresholds": {
        "additionalProperties": false,
        "properties": {
          "input_per_million": {
            "default": 1,
            "minimum": 0.0,
            "title": "Input Per Million",
            "type": "number"
          },
          "max_cost_usd": {
            "default": 0.05,
            "minimum": 0.0,
            "title": "Max Cost Usd",
            "type": "number"
          },
          "max_latency_ms": {
            "default": 10000,
            "exclusiveMinimum": 0.0,
            "title": "Max Latency Ms",
            "type": "number"
          },
          "max_regression": {
            "default": 0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Max Regression",
            "type": "number"
          },
          "min_pass_rate": {
            "default": 1,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Pass Rate",
            "type": "number"
          },
          "output_per_million": {
            "default": 4,
            "minimum": 0.0,
            "title": "Output Per Million",
            "type": "number"
          }
        },
        "title": "Thresholds",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
